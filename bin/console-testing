<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

$configFile = dirname(__DIR__) . '/config/local.testing.neon';

try {
    if (!is_file($configFile)) {
        throw new LogicException('Chybí config/local.testing.neon. Vytvoř jej podle přiloženého .example souboru.');
    }

    $config = Nette\Neon\Neon::decodeFile($configFile);
    if (!is_array($config)) {
        throw new LogicException('Testovací konfigurace není platná NEON struktura.');
    }

    $parameters = $config['parameters'] ?? null;
    $appParameters = is_array($parameters) ? ($parameters['app'] ?? null) : null;
    $database = $config['database'] ?? null;
    $migration = $config['dbal'] ?? null;

    $environment = is_array($appParameters) ? ($appParameters['environment'] ?? null) : null;
    $databaseDsn = is_array($database) ? ($database['dsn'] ?? null) : null;
    $databaseUser = is_array($database) ? ($database['user'] ?? null) : null;
    $migrationHost = is_array($migration) ? ($migration['host'] ?? null) : null;
    $migrationDatabase = is_array($migration) ? ($migration['database'] ?? null) : null;
    $migrationUser = is_array($migration) ? ($migration['username'] ?? null) : null;

    if (
        $environment !== 'testing'
        || !is_string($databaseDsn)
        || !preg_match('/(?:^|;)host=([^;]+)/i', $databaseDsn, $hostMatches)
        || $hostMatches[1] !== '127.0.0.1'
        || !preg_match('/(?:^|;)dbname=([^;]+)/i', $databaseDsn, $databaseMatches)
        || $databaseMatches[1] !== 'argomi_bestshop_test'
        || $databaseUser !== 'argomi_test_app'
        || $migrationHost !== '127.0.0.1'
        || $migrationDatabase !== 'argomi_bestshop_test'
        || $migrationUser !== 'argomi_test_migrator'
    ) {
        throw new LogicException(
            'Testovací konzole odmítla konfiguraci: očekává environment=testing, '
            . 'host 127.0.0.1, databázi argomi_bestshop_test a vyhrazené testovací účty.',
        );
    }

    // Testovací konzole povoluje pouze migrace vpřed a pomocné příkazy.
    // Zejména migrations:reset nesmí být dostupné, protože databázi maže.
    $command = $argv[1] ?? 'list';
    if (!in_array($command, ['migrations:continue', 'list', 'help', '--help', '--version'], true)) {
        throw new LogicException(sprintf('Příkaz "%s" není v testovací konzoli povolen.', $command));
    }

    $bootstrap = new App\Bootstrap('local.testing.neon');
    $container = $bootstrap->bootWebApplication();
    $application = $container->getByType(Contributte\Console\Application::class);

    exit($application->run());
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage() . PHP_EOL);
    exit(1);
}
