# see https://doc.nette.org/en/configuring

parameters:
	app:
		environment: null
	logging:
		file: %appDir%/../log/application.log
		maxFiles: 30
		level: DEBUG

extensions:
	console: Contributte\Console\DI\ConsoleExtension(true)
	dbal: Nextras\Dbal\Bridges\NetteDI\DbalExtension
	migrations: Nextras\Migrations\Bridges\NetteDI\MigrationsExtension

# Nextras řadí migrace globálně podle názvu souboru napříč skupinami.
# Závislosti skupin řeší až shodné názvy; skupiny nejsou samostatné fáze.
# Časové prefixy proto musí zachovat skutečné pořadí závislých SQL změn.
migrations:
	dir: %appDir%/../migrations
	driver: mysql
	dbal: nextras
	groups:
		structures:
			directory: %appDir%/../migrations/structures
			enabled: true
		basic-data:
			directory: %appDir%/../migrations/basic-data
			enabled: true
			dependencies: [structures]
		dummy-data:
			directory: %appDir%/../migrations/dummy-data
			enabled: true
			dependencies: [basic-data]


application:
	errorPresenter:
		4xx: Error:Error4xx
		5xx: Error:Error5xx
	mapping:
		*: App\Presentation\*\**Presenter
		Front: App\UI\Front\**Presenter
		Admin: [App\UI\Admin, '', **Presenter]


latte:
	strictParsing: yes


assets:
	mapping:
		default:
			path: assets


di:
	export:
		parameters: no
		tags: no
