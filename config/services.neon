services:
  - App\Core\RouterFactory::createRouter
  - App\Core\Logging\SensitiveDataProcessor
  - App\Core\Logging\LoggerFactory::createLogger(@App\Core\Logging\SensitiveDataProcessor, %logging.file%, %logging.maxFiles%, %logging.level%)
  - App\Shared\Infrastructure\Console\DbResetEnvironmentPolicy(%app.environment%)
  - App\Shared\Infrastructure\Console\DbResetCommand
  - App\Shared\Infrastructure\Console\OutboxWorkerCommand
  - App\Modules\Translation\Infrastructure\Diagnostics\TranslationKeyUsageScanner(%appDir%/UI)
  - App\Modules\Translation\Infrastructure\Console\TranslationsCheckCommand
  # Resolver má vlastní název a nespadá do automatického vyhledávání tříd se suffixem Service.
  - App\Modules\Catalog\Application\OptionResolver
  # Autorizační policy je explicitní služba, protože nespadá pod automatické suffixové vyhledávání.
  - App\Modules\Catalog\Application\CatalogPermissionResolver
  # Dispatcher dostává všechny služby označené tagem domainEventListener už při kompilaci DI kontejneru.
  - App\Shared\Infrastructure\Event\SynchronousEventDispatcher(
    listeners: tagged(domainEventListener)
  )
  # Transakční adaptér se automaticky zpřístupní přes jediné implementované rozhraní Transaction.
  - App\Shared\Infrastructure\Transaction\NetteTransaction
  # Outbox writer zapisuje pouze do již aktivní transakce volající obchodní operace.
  - App\Shared\Infrastructure\Outbox\DatabaseOutboxWriter
  # Worker zpracovává pouze zprávy převzaté s platným lease; handlery se registrují tagem outboxMessageHandler.
  - App\Shared\Infrastructure\Outbox\DatabaseOutboxWorker(handlers: tagged(outboxMessageHandler))
  # Produkční hodiny jsou jedinou registrovanou implementací Clock; FrozenClock zůstává pouze pro testy.
  - App\Shared\Infrastructure\Clock\SystemClock
  # Generátor veřejných ULID je jedinou registrovanou implementací rozhraní PublicIdGenerator.
  - App\Shared\Infrastructure\PublicId\SymfonyUlidGenerator
  # Fyzické soubory katalogových obrázků zůstávají mimo veřejný adresář www/.
  - App\Modules\Catalog\Infrastructure\Storage\InterventionProductImageProcessor
  - App\Modules\Catalog\Infrastructure\Storage\FilesystemProductImageStorage(%appDir%/../var/catalog-images)
  # Poskytovatel není zachycen automatickým vyhledáváním *Service/*Repository,
  # proto jej registrujeme výslovně. Rozhraní CurrencyProvider se pak autowiruje
  # přes jedinou dostupnou implementaci.
  - App\Shared\Infrastructure\Persistence\Money\DatabaseCurrencyProvider
  # Aktivní jazyky a výchozí jazyk se načítají z tabulky language; router nesmí obsahovat pevný seznam kódů.
  - App\Shared\Infrastructure\Persistence\Locale\DatabaseLocaleProvider


search:
  - in: %appDir%
    classes:
      - *Facade
      - *Factory
      - *Repository
      - *Service
