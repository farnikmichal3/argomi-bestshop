services:
	- App\Core\RouterFactory::createRouter
	- App\Core\Logging\SensitiveDataProcessor
	- App\Core\Logging\LoggerFactory::createLogger(@App\Core\Logging\SensitiveDataProcessor, %logging.file%, %logging.maxFiles%, %logging.level%)
	- App\Shared\Infrastructure\Console\DbResetCommand
	# Synchronní dispatcher je jedinou produkční implementací EventDispatcher; posluchače doplní F2-11 přes DI tagy.
	- App\\Shared\\Infrastructure\\Event\\SynchronousEventDispatcher
	# Produkční hodiny jsou jedinou registrovanou implementací Clock; FrozenClock zůstává pouze pro testy.
	- App\Shared\Infrastructure\Clock\SystemClock
	# Generátor veřejných ULID je jedinou produkční implementací rozhraní PublicIdGenerator.
	- App\Shared\Infrastructure\PublicId\SymfonyUlidGenerator
	# Poskytovatel není zachycen automatickým vyhledáváním *Service/*Repository,
	# proto jej registrujeme výslovně. Rozhraní CurrencyProvider se pak autowiruje
	# přes jedinou dostupnou implementaci.
	- App\Shared\Infrastructure\Persistence\Money\DatabaseCurrencyProvider
	# Aktivní jazyky a výchozí jazyk se načítají z tabulky language; router nesmí obsahovat pevný seznam kódů.
	- App\Shared\Infrastructure\Persistence\Locale\DatabaseLocaleProvider


search:
	-	in: %appDir%
		classes:
			- *Facade
			- *Factory
			- *Repository
			- *Service
