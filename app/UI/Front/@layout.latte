<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width">

	<title>{ifset title}{include title|stripHtml} | {/ifset}ArgoMi BestShop</title>

	<link rel="stylesheet" href="{$basePath}/assets/front.css">
    {block head}{/block}
</head>

<body>
	<div n:foreach="$flashes as $flash" n:class="flash, $flash->type">{$flash->message}</div>

	{include content}

	 <script src="{$basePath}/assets/front.js"></script>
    {block scripts}{/block}
</body>
</html>
