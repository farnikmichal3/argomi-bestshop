<!DOCTYPE html>
<html lang="{$presenter->getParameter('lang') ?? 'cs'}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>{ifset title}{include title|stripHtml} | {/ifset}ArgoMi BestShop</title>

	<link rel="stylesheet" href="{$basePath}/assets/admin.css">
    {block head}{/block}
</head>

<body>
    <a class="visually-hidden-focusable" href="#admin-main">{_'admin.layout.skip'}</a>

    <header class="border-bottom shadow-sm">
        <nav class="navbar navbar-expand-lg bg-body-tertiary" aria-label="{_'admin.navigation.label'}">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" n:href=":Admin:Dashboard:default">ArgoMi BestShop</a>

                <button
                    class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#adminNavigation"
                    aria-controls="adminNavigation"
                    aria-expanded="false"
                    aria-label="{_'admin.navigation.toggle'}"
                >
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="adminNavigation">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a
                                class="nav-link {if $presenter->getName() === 'Admin:Dashboard'}active{/if}"
                                n:href=":Admin:Dashboard:default"
                                n:attr="aria-current => $presenter->getName() === 'Admin:Dashboard' ? 'page' : null"
                            >{_'admin.navigation.dashboard'}</a>
                        </li>
                        <li class="nav-item" n:if="$canViewCatalog">
                            <a
                                class="nav-link {if $presenter->getName() === 'Admin:Products'}active{/if}"
                                n:href=":Admin:Products:default"
                                n:attr="aria-current => $presenter->getName() === 'Admin:Products' ? 'page' : null"
                            >{_'admin.navigation.products'}</a>
                        </li>
                        <li class="nav-item" n:if="$canViewCatalog">
                            <a
                                class="nav-link {if $presenter->getName() === 'Admin:Catalog:Categories'}active{/if}"
                                n:href=":Admin:Catalog:Categories:default"
                                n:attr="aria-current => $presenter->getName() === 'Admin:Catalog:Categories' ? 'page' : null"
                            >{_'admin.navigation.categories'}</a>
                        </li>
                        <li class="nav-item" n:if="$canViewTranslations">
                            <a
                                class="nav-link {if $presenter->getName() === 'Admin:Translations'}active{/if}"
                                n:href=":Admin:Translations:default"
                                n:attr="aria-current => $presenter->getName() === 'Admin:Translations' ? 'page' : null"
                            >{_'admin.navigation.translations'}</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center">
                        {ifset $showAdminLogout}
                            {control logoutForm}
                        {/ifset}
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid pt-3" n:if="$flashes !== []">
        <div n:foreach="$flashes as $flash" class="alert alert-{$flash->type} alert-dismissible fade show" role="alert">
            {$flash->message}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>

    <div id="admin-main" tabindex="-1">
        {include content}
    </div>

    <script src="{$basePath}/assets/admin.js"></script>
    {block scripts}{/block}
</body>
</html>
