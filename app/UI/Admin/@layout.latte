<!DOCTYPE html>
<html lang="{$adminLocaleCode}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{ifset title}{include title|stripHtml} | {/ifset}ArgoMi BestShop</title>
    <link rel="stylesheet" href="{$basePath}/assets/admin.css">
    <link rel="stylesheet" href="{$basePath}/assets/admin-custom.css">
    {block head}{/block}
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <a class="visually-hidden-focusable" href="#admin-main">{$adminTranslator->translate('admin.layout.skip')}</a>
    <div class="app-wrapper">
        <nav class="app-header navbar navbar-expand bg-body shadow-sm" aria-label="{$adminTranslator->translate('admin.navigation.label')}">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="{$adminTranslator->translate('admin.navigation.toggle')}">
                            <i class="bi bi-list" aria-hidden="true"></i>
                        </a>
                    </li>
                </ul>
                <span class="navbar-text fw-semibold">ArgoMi BestShop</span>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item d-flex align-items-center">
                        {ifset $showAdminLogout}{control logoutForm}{/ifset}
                    </li>
                </ul>
            </div>
        </nav>
        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
            <div class="sidebar-brand">
                <a class="brand-link" n:href=":Admin:Dashboard:default">
                    <span class="brand-text fw-light">ArgoMi BestShop</span>
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-2" aria-label="{$adminTranslator->translate('admin.navigation.label')}">
                    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">
                        <li class="nav-header">{$adminTranslator->translate('admin.navigation.main')}</li>
                        <li class="nav-item">
                            <a class="nav-link {if $presenter->getName() === 'Admin:Dashboard'}active{/if}" n:href=":Admin:Dashboard:default" n:attr="aria-current => $presenter->getName() === 'Admin:Dashboard' ? 'page' : null">
                                <i class="nav-icon bi bi-speedometer2" aria-hidden="true"></i>
                                <p>{$adminTranslator->translate('admin.navigation.dashboard')}</p>
                            </a>
                        </li>
                        <li class="nav-header" n:if="$canViewCatalog">{$adminTranslator->translate('admin.navigation.catalog')}</li>
                        <li class="nav-item" n:if="$canViewCatalog">
                            <a class="nav-link {if $presenter->getName() === 'Admin:Products'}active{/if}" n:href=":Admin:Products:default" n:attr="aria-current => $presenter->getName() === 'Admin:Products' ? 'page' : null">
                                <i class="nav-icon bi bi-box-seam" aria-hidden="true"></i>
                                <p>{$adminTranslator->translate('admin.navigation.products')}</p>
                            </a>
                        </li>
                        <li class="nav-item" n:if="$canViewCatalog">
                            <a class="nav-link {if $presenter->getName() === 'Admin:Catalog:Categories'}active{/if}" n:href=":Admin:Catalog:Categories:default" n:attr="aria-current => $presenter->getName() === 'Admin:Catalog:Categories' ? 'page' : null">
                                <i class="nav-icon bi bi-diagram-3" aria-hidden="true"></i>
                                <p>{$adminTranslator->translate('admin.navigation.categories')}</p>
                            </a>
                        </li>
                        <li class="nav-header" n:if="$canViewTranslations">{$adminTranslator->translate('admin.navigation.system')}</li>
                        <li class="nav-item" n:if="$canViewTranslations">
                            <a class="nav-link {if $presenter->getName() === 'Admin:Translations'}active{/if}" n:href=":Admin:Translations:default" n:attr="aria-current => $presenter->getName() === 'Admin:Translations' ? 'page' : null">
                                <i class="nav-icon bi bi-translate" aria-hidden="true"></i>
                                <p>{$adminTranslator->translate('admin.navigation.translations')}</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>
        <main class="app-main" id="admin-main" tabindex="-1">
            <div class="app-content-header">
                <div class="container-fluid">
                    {ifset title}<h1 class="mb-0">{include title}</h1>{/ifset}
                </div>
            </div>
            <div class="app-content">
                <div class="container-fluid">
                    <div n:if="$flashes !== []" class="mb-3">
                        <div n:foreach="$flashes as $flash" class="alert alert-{$flash->type} alert-dismissible fade show" role="alert">
                            {$flash->message}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{$adminTranslator->translate('admin.flash.close')}"></button>
                        </div>
                    </div>
                    {include content}
                </div>
            </div>
        </main>
        <footer class="app-footer"><strong>ArgoMi BestShop</strong></footer>
    </div>
    <script src="{$basePath}/assets/admin.js"></script>
    {block scripts}{/block}
</body>
</html>
