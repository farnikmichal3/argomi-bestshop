{block title}{_'products.variants.title'}{/block}

{block content}
<div class="py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <div class="text-body-secondary small">{$matrix->productCode}</div>
            <h2 class="h4 mb-0">{$matrix->productName ?? $matrix->productCode}</h2>
        </div>
        {if $canManage}
        <a class="btn btn-outline-secondary" n:href=":Admin:Products:edit, id => $matrix->productId">
        {else}
        <a class="btn btn-outline-secondary" n:href=":Admin:Products:default">
        {/if}
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            {_'products.variants.back_to_product'}
        </a>
    </div>

    <section class="card mb-3">
        <div class="card-header">
            <h2 class="h5 mb-0">{_'products.variants.axes'}</h2>
        </div>
        <div class="card-body">
            {if $hasAxes}
                <dl class="row mb-0">
                    {foreach $matrix->axes as $axis}
                        <dt class="col-sm-3 mb-2">
                            {$axis->name ?? $axis->code}
                            <span class="text-body-secondary small">({$axis->type})</span>
                        </dt>
                        <dd class="col-sm-9 mb-2">
                            {if $axis->values !== []}
                                {foreach $axis->values as $value}
                                    <span class="badge text-bg-light border me-1 mb-1">
                                        {if $value->value === true}
                                            {_'products.variants.value.true'}
                                        {elseif $value->value === false}
                                            {_'products.variants.value.false'}
                                        {else}
                                            {$value->label ?? $value->value}
                                        {/if}
                                    </span>
                                {/foreach}
                            {else}
                                <span class="text-body-secondary">—</span>
                            {/if}
                        </dd>
                    {/foreach}
                </dl>
            {else}
                <div class="alert alert-info mb-0" role="status">
                    {_'products.variants.no_axes'}
                </div>
            {/if}
        </div>
    </section>

    {if $hasAxes}
        <section class="card mb-3">
            <div class="card-header">
                <h2 class="h5 mb-0">{_'products.variants.combinations'}</h2>
            </div>
            <div class="card-body p-0">
                {if $hasValues}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">{_'products.variants.combinations'}</th>
                                    <th scope="col">{_'products.variants.sku'}</th>
                                    <th scope="col">{_'products.variants.state'}</th>
                                    <th scope="col" class="text-end">{_'products.variant_editor.title'}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {foreach $combinationRows as $row}
                                    <tr>
                                        <td>{$row['label']}</td>
                                        <td>{$row['sku'] ?? '—'}</td>
                                        <td>
                                            {if $row['exists']}
                                                <span class="badge text-bg-success">{_'products.variants.existing'}</span>
                                                {if $row['isActive']}
                                                    <span class="badge text-bg-primary">{_'products.variants.active'}</span>
                                                {else}
                                                    <span class="badge text-bg-secondary">{_'products.variants.inactive'}</span>
                                                {/if}
                                                {if $row['isDefault']}
                                                    <span class="badge text-bg-warning">{_'products.variants.default'}</span>
                                                {/if}
                                            {else}
                                                <span class="badge text-bg-light border">{_'products.variants.missing'}</span>
                                            {/if}
                                        </td>
                                        <td class="text-end">
                                            {if $row['variantId'] !== null && $canManage}
                                                <a class="btn btn-sm btn-outline-primary" n:href=":Admin:Products:Variant:edit, id => $row['variantId']">
                                                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                                    {_'products.variant_editor.title'}
                                                </a>
                                            {elseif $row['variantId'] !== null}
                                                {_'products.variants.existing'}
                                            {else}
                                                —
                                            {/if}
                                        </td>
                                    </tr>
                                {/foreach}
                            </tbody>
                        </table>
                    </div>
                {else}
                    <div class="alert alert-warning m-3 mb-0" role="status">
                        {_'products.variants.no_values'}
                    </div>
                {/if}
            </div>
        </section>

        {if $canGenerate}
            <section class="card">
                <div class="card-header">
                    <h2 class="h5 mb-0">{_'products.variants.generate'}</h2>
                </div>
                <div class="card-body">
                    <p class="text-body-secondary">{_'products.variants.select_combinations'}</p>
                    {control generateForm}
                </div>
            </section>
        {elseif $hasValues}
            <div class="alert alert-success" role="status">
                {_'products.variants.no_missing'}
            </div>
        {/if}
    {/if}

    <div class="mt-3">
        {if $canManage}
            <a class="btn btn-outline-secondary" n:href=":Admin:Products:edit, id => $matrix->productId">
                {_'products.variants.cancel'}
            </a>
        {else}
            <a class="btn btn-outline-secondary" n:href=":Admin:Products:default">
                {_'products.variants.cancel'}
            </a>
        {/if}
    </div>
</div>
{/block}
