{block title}{_'products.variant_editor.title'}{/block}

{block content}
<div class="py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <div class="text-body-secondary small">{$variant->productCode} · {$variant->sku}</div>
            <h1 class="h3 mb-0">{$variant->productName ?? $variant->productCode}</h1>
        </div>
        <a class="btn btn-outline-secondary" n:href=":Admin:Products:Variants:default, id => $variant->productId">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            {_'products.variant_editor.cancel'}
        </a>
    </div>

    {if !$variant->isActive}
        <div class="alert alert-warning" role="status">
            {_'products.variant_editor.inactive'}
        </div>
    {/if}

    <section class="card">
        <div class="card-body">
            <p class="text-body-secondary">
                {_'products.variant_editor.ean_hint'}
            </p>
            <p class="text-body-secondary">
                {_'products.variant_editor.weight_hint'}
            </p>
            {control variantForm}
        </div>
    </section>
</div>
{/block}
