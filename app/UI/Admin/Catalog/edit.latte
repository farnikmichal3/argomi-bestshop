{block title}{_'categories.edit.title'}{/block}

{block content}
<main class="container py-5">
    <h1>{_'categories.edit.title'}</h1>
    <section class="card">
        <div class="card-body">
            {control editForm}
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a class="btn btn-outline-secondary" n:href="default">{_'categories.edit.cancel'}</a>
                {control deleteForm}
            </div>
        </div>
    </section>
</main>
{/block}
