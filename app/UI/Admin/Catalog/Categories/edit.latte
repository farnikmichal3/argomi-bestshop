{block title}{_'categories.edit.title'}{/block}

{block content}
<div class="py-3">
    <section class="card">
        <div class="card-body">
            {control editForm}
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a class="btn btn-outline-secondary" n:href="default">{_'categories.edit.cancel'}</a>
                {control deleteForm}
            </div>
        </div>
    </section>
</div>
{/block}
