{block title}{_'categories.title'}{/block}

{block content}
<main class="container py-5">
    <h1>{_'categories.title'}</h1>

    {if $canManage}
        <section class="card mb-4">
            <div class="card-body">
                <h2 class="h4">{_'categories.form.title'}</h2>
                {control createForm}
            </div>
        </section>
    {/if}

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>{_'categories.column.id'}</th>
                    <th>{_'categories.column.code'}</th>
                    <th>{_'categories.column.name'}</th>
                    <th>{_'categories.column.status'}</th>
                    {if $canManage}<th>{_'categories.action.edit'}</th>{/if}
                </tr>
            </thead>
            <tbody>
                <tr n:foreach="$categories as $row">
                    <td>{$row['category']->id}</td>
                    <td>
                        <span>{$row['prefix']}
                            <code>{$row['category']->code}</code>
                        </span>
                    </td>
                    <td>{$row['category']->name ?? '—'}</td>
                    <td>
                        {if $row['category']->isActive}
                            {_'categories.status.active'}
                        {else}
                            {_'categories.status.inactive'}
                        {/if}
                    </td>
                    {if $canManage}<td><a class="btn btn-sm btn-outline-primary" n:href="edit, id => $row['category']->id">{_'categories.action.edit'}</a></td>{/if}
                </tr>
                <tr n:if="$categories === []">
                    <td colspan="{if $canManage}5{else}4{/if}">{_'categories.empty'}</td>
                </tr>
            </tbody>
        </table>
    </div>
</main>
{/block}
