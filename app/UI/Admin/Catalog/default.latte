{block content}
<main class="container py-5">
    <h1>Kategorie katalogu</h1>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Kód</th>
                    <th>Název</th>
                    <th>Stav</th>
                </tr>
            </thead>
            <tbody>
                <tr n:foreach="$categories as $row">
                    <td>{$row['category']->category->id}</td>
                    <td>
                        <span style="padding-left: {$row['depth'] * 1.5}rem">
                            <code>{$row['category']->category->code}</code>
                        </span>
                    </td>
                    <td>{$row['category']->translation?->name ?? '—'}</td>
                    <td>{if $row['category']->category->isActive}Aktivní{else}Neaktivní{/if}</td>
                </tr>
                <tr n:if="$categories === []">
                    <td colspan="4">Zatím nejsou vytvořené žádné kategorie.</td>
                </tr>
            </tbody>
        </table>
    </div>
</main>
{/block}
