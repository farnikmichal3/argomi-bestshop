{block title}{_'attributes.edit.title'}{/block}

{block content}
<div class="py-3">
    <section class="card mb-4">
        <div class="card-body">
            {if $attribute->isUsed}
                <div class="alert alert-info" role="status">{_'attributes.edit.in_use'}</div>
            {/if}
            {control editForm}
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a class="btn btn-outline-secondary" n:href="default">{_'attributes.form.cancel'}</a>
                {control deleteForm}
            </div>
        </div>
    </section>

    {if $attribute->type->value === 'enum'}
        <section class="card mb-4">
            <div class="card-body">
                <h2 class="h4">{_'attributes.values.title'}</h2>
                <p class="text-body-secondary">{_'attributes.values.help'}</p>
                <div class="table-responsive mb-4">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th scope="col">{_'attributes.values.column.id'}</th>
                                <th scope="col">{_'attributes.values.column.code'}</th>
                                <th scope="col">{_'attributes.values.column.label'}</th>
                                <th scope="col">{_'attributes.values.column.sort_order'}</th>
                                <th scope="col">{_'attributes.values.column.actions'}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr n:foreach="$attribute->values as $value">
                                <td>{$value->id}</td>
                                <td><code>{$value->code}</code></td>
                                <td>{$value->translations[$adminLocaleCode] ?? '—'}</td>
                                <td>{$value->sortOrder}</td>
                                <td><a class="btn btn-sm btn-outline-primary" n:href="editValue, id => $attribute->id, valueId => $value->id">{_'attributes.action.edit'}</a></td>
                            </tr>
                            <tr n:if="$attribute->values === []">
                                <td colspan="5">{_'attributes.values.empty'}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <h3 class="h5">{_'attributes.values.create.title'}</h3>
                {control createValueForm}
            </div>
        </section>
    {/if}
</div>
{/block}
