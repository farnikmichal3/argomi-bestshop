{
	"name": "argomi/argomi-bestshop",
	"description": "ArgoMi BestShop – modular e-commerce application",
	"keywords": [
		"nette"
	],
	"type": "project",
	"license": "proprietary",
	"require": {
		"php": ">=8.3",
		"contributte/console": "^0.11.0",
		"ezyang/htmlpurifier": "^4.19",
		"latte/latte": "^3.1",
		"monolog/monolog": "^3.12",
		"nette/application": "^3.2.3",
		"nette/assets": "^1.0.0",
		"nette/bootstrap": "^3.2.6",
		"nette/caching": "^3.2",
		"nette/database": "^3.2",
		"nette/di": "^3.2",
		"nette/forms": "^3.2",
		"nette/http": "^3.3",
		"nette/mail": "^4.0",
		"nette/robot-loader": "^4.0",
		"nette/security": "^3.2",
		"nette/utils": "^4.0",
		"nextras/dbal": "^5.0",
		"nextras/migrations": "^3.5",
		"tracy/tracy": "^2.10"
	},
	"require-dev": {
		"deptrac/deptrac": "^4.7",
		"friendsofphp/php-cs-fixer": "^3.95",
		"nette/phpstan-rules": "^1.0",
		"nette/tester": "^2.5",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.3",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/phpstan-nette": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.1",
		"symfony/thanks": "^1"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s",
		"db:reset": "@php bin/console db:reset"
	},
	"minimum-stability": "stable",
	"config": {
		"allow-plugins": {
			"symfony/thanks": true,
			"phpstan/extension-installer": true
		},
		"platform": {
			"php": "8.3.0"
		},
		"sort-packages": true
	}
}
