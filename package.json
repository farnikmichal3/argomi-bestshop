{
	"type": "module",
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"bootstrap": "^5.3.8",
		"naja": "^3.3.3",
		"nette-forms": "^3.3"
	},
	"devDependencies": {
		"@nette/vite-plugin": "^1.0.1",
		"esbuild": "^0.28.2",
		"sass": "^1.107.1",
		"vite": "^6.3.5"
	},
	"scripts": {
		"build:css": "sass --load-path=node_modules --style=compressed assets/scss/app.scss www/assets/app.css",
		"build:js": "esbuild assets/js/app.js --bundle --minify --outfile=www/assets/app.js",
		"build": "npm run build:css && npm run build:js",
		"watch:css": "sass --load-path=node_modules --watch assets/scss/app.scss www/assets/app.css",
		"watch:js": "esbuild assets/js/app.js --bundle --outfile=www/assets/app.js --watch"
	},
	"name": "argomi-bestshop",
	"version": "1.0.0",
	"description": "Nette Web Project =================",
	"main": "index.js",
	"keywords": [],
